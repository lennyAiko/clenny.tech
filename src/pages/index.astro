---
import SiteLayout from "../layouts/SiteLayout.astro";
import Socials from "../components/Socials.astro";
import Projects from "../components/Projects.astro";
---

<SiteLayout title="Lennox C. Charles | Web Developer & Indie Hacker">
  <main class="mx-auto max-w-5xl px-6 pb-24 pt-16 sm:pt-32">
    <section class="grid grid-cols-1 gap-12 lg:grid-cols-5 lg:items-center">
      <div class="lg:col-span-3 order-2 lg:order-1">
        <div
          class="inline-flex items-center space-x-2 rounded-full bg-purple-500/10 px-3 py-1 text-sm font-medium text-purple-400 ring-1 ring-inset ring-purple-500/20 mb-6"
        >
          <span>Available for new projects</span>
        </div>

        <h1
          class="text-4xl font-bold tracking-tight text-white sm:text-6xl mb-6"
        >
          Hello, I'm Lennox!
        </h1>

        <p class="text-lg sm:text-xl text-gray-300 leading-relaxed mb-6">
          Open-source <span class="text-white font-semibold">contributor</span>,
          Indie <span class="text-white font-semibold">hacker</span>, and
          Technical <span class="text-white font-semibold">writer</span>.
        </p>

        <p class="text-base sm:text-lg text-gray-400 leading-8 mb-10 max-w-2xl">
          I help developers bridge the gap between building and shipping.
          Currently documenting my journey in web development and sharing
          everything I learn about indie hacking along the way.
        </p>

        <div class="pt-8 border-t border-gray-800">
          <h3
            class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-4"
          >
            Connect with me
          </h3>
          <Socials />
        </div>
      </div>

      <div
        class="lg:col-span-2 order-1 lg:order-2 flex justify-center lg:justify-end"
      >
        <div class="relative group">
          <div
            class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-purple-600 to-blue-600 opacity-25 blur transition duration-1000 group-hover:opacity-40"
          >
          </div>

          <div
            class="relative overflow-hidden rounded-2xl bg-gray-900 border border-white/10 shadow-2xl"
          >
            <img
              src="/lcc.png"
              alt="Lennox C. Charles"
              width={500}
              height={500}
              loading="eager"
              class="aspect-square w-full max-w-[320px] lg:max-w-none object-cover transition duration-500 group-hover:scale-105"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="mt-32 pt-16 border-t border-gray-800">
      <div class="flex items-center justify-between mb-12">
        <h2 class="text-3xl font-bold tracking-tight text-white">
          Featured Work
        </h2>
        <a
          href="/projects"
          class="text-sm font-semibold text-purple-400 hover:text-purple-300"
        >
          View all projects &rarr;
        </a>
      </div>
      <Projects />
    </section>
  </main>
</SiteLayout>
