---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import ProjectLink from "../components/ProjectLink.astro";

const projects = await getCollection("other-projects");
---

<SiteLayout
  title="Lennox C. Charles Projects"
  description="See the projects I worked on so far, and technologies I am interested in."
>
  <main class="mx-auto max-w-5xl px-6 pb-28 pt-16 sm:pt-24">
    <header class="max-w-2xl mb-16 md:mb-24">
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Projects
      </h1>
      <p class="mt-6 text-lg text-gray-400">
        A collection of side projects and professional work exploring web
        performance, API design, and developer tools.
      </p>
    </header>

    <div class="space-y-24">
      {
        projects.map((project, index) => (
          <article
            class={`flex flex-col gap-8 md:gap-12 items-center ${
              index % 2 !== 0 ? "md:flex-row-reverse" : "md:flex-row"
            }`}
          >
            <div class="w-full md:w-1/2 group relative">
              <div class="absolute -inset-2 rounded-2xl bg-gradient-to-r from-purple-500/20 to-blue-500/20 opacity-0 blur-xl transition duration-500 group-hover:opacity-100" />
              <div class="relative overflow-hidden rounded-xl border border-white/10 bg-gray-900 shadow-2xl">
                <img
                  src={project.data.img}
                  alt={project.data.title}
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover object-top transition duration-500 group-hover:scale-105"
                />
              </div>
            </div>

            <div class="w-full md:w-1/2 space-y-4">
              <div class="inline-flex items-center rounded-full bg-purple-500/10 px-3 py-1 text-xs font-medium text-purple-400 ring-1 ring-inset ring-purple-500/20">
                Featured Project
              </div>

              <ProjectLink
                title={project.data.title}
                description={project.data.description}
                link={project.data.link}
                cta={project.data.cta}
              />
            </div>
          </article>
        ))
      }
    </div>
  </main>
</SiteLayout>
