---
import SiteLayout from "../layouts/SiteLayout.astro";

const allPosts = await Astro.glob("./blog/*.{md,mdx}");
const posts = allPosts
  .filter((post) => !post.frontmatter.draft)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).valueOf() -
      new Date(a.frontmatter.pubDate).valueOf(),
  );

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString("en-us", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<SiteLayout
  title="Lennox C. Charles Blog"
  description="Learn about web development, indie hacking, open source and my personal studies."
>
  <main class="mx-auto max-w-4xl px-6 pb-28">
    <header class="py-16 md:py-24 max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Writing
      </h1>
      <p class="mt-6 text-base text-gray-400 leading-7">
        Thoughts on web development, indie hacking, and open source.
      </p>
    </header>

    <div class="space-y-12 md:space-y-16">
      {
        posts.map((post) => (
          <article class="group relative">
            <div class="absolute -inset-x-4 -inset-y-4 z-0 rounded-2xl bg-gray-800/50 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:scale-[1.01] sm:-inset-x-6 ring-1 ring-white/10" />

            <div class="relative z-10 grid grid-cols-1 md:grid-cols-4 md:gap-8 items-baseline">
              <time
                class="mb-3 md:mb-0 text-sm font-medium text-gray-500 transition-colors group-hover:text-purple-400"
                datetime={post.frontmatter.pubDate}
              >
                {formatDate(post.frontmatter.pubDate)}
              </time>

              <div class="md:col-span-3">
                <h2 class="text-xl font-semibold tracking-tight text-gray-100 group-hover:text-white transition-colors">
                  <a href={post.url} class="outline-none">
                    <span class="absolute -inset-x-4 -inset-y-4 z-20 sm:-inset-x-6 sm:rounded-2xl" />
                    {post.frontmatter.title}
                  </a>
                </h2>

                <p class="mt-3 text-sm leading-relaxed text-gray-400 group-hover:text-gray-300 transition-colors">
                  {post.frontmatter.description}
                </p>

                <div class="mt-4 flex items-center text-sm font-semibold text-purple-400 transition-all">
                  <span>Read article</span>
                  <svg
                    class="ml-1 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                    viewBox="0 0 16 16"
                    fill="none"
                  >
                    <path
                      d="M6.75 5.75 9.25 8l-2.5 2.25"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </main>
</SiteLayout>
