---
import SiteLayout from "../layouts/SiteLayout.astro";

const services = [
  {
    title: "Web Design & Development",
    description:
      "I build stunning, minimal full-stack applications designed to grow businesses. Includes SEO, maintenance, and content strategy.",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4", // Code icon
  },
  {
    title: "API Development",
    description:
      "Build robust, secure gateways to scale your services. I specialize in designing high-performance APIs for businesses and individuals.",
    icon: "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z", // Terminal icon
  },
  {
    title: "Software Dev Kits (SDKs)",
    description:
      "Make it easy for developers to integrate with your platform. I create battle-tested SDKs that reduce friction and increase adoption.",
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4", // Box/Package icon
  },
  {
    title: "Custom Web Tools",
    description:
      "Need a specific automation or internal tool? I develop lightweight, easy-to-use utilities tailored to your unique workflow needs.",
    icon: "M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z", // Puzzle icon
  },
  {
    title: "Technical Writing",
    description:
      "Clear, informative documentation and articles that bridge the gap between complex code and user understanding.",
    icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z", // Pencil icon
  },
];
---

<SiteLayout title="Services | Lennox C. Charles">
  <main class="mx-auto max-w-5xl px-6 pb-24 pt-16 sm:pt-24">
    <header class="max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        My Services
      </h1>
      <p class="mt-6 text-lg text-gray-400">
        I bridge the gap between design and complex engineering, providing
        full-stack solutions that focus on performance and developer experience.
      </p>
    </header>

    <section class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-2">
      {
        services.map((service) => (
          <div class="group relative flex flex-col p-6 rounded-2xl bg-gray-900/50 border border-gray-800 transition-all hover:bg-gray-800/50 hover:border-purple-500/30">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-500/10 text-purple-400 mb-4 group-hover:scale-110 transition-transform">
              <svg
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d={service.icon}
                />
              </svg>
            </div>

            <h2 class="text-xl font-bold text-gray-100 mb-2 group-hover:text-purple-300 transition-colors">
              {service.title}
            </h2>

            <p class="text-gray-400 leading-relaxed text-sm md:text-base">
              {service.description}
            </p>
          </div>
        ))
      }

      <div
        class="flex flex-col justify-center items-center p-8 rounded-2xl bg-gradient-to-br from-purple-600/20 to-transparent border border-purple-500/20 text-center"
      >
        <h2 class="text-xl font-bold text-white mb-4">
          Have a unique project?
        </h2>
        <p class="text-gray-400 text-sm mb-6">
          Let's discuss how I can help you scale your next big idea.
        </p>
        <a
          href="mailto:lennyaiko17@gmail.com"
          class="inline-flex items-center justify-center rounded-full bg-purple-500 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 focus:ring-offset-gray-900 shadow-lg shadow-purple-500/20"
        >
          Book a Consultation
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
